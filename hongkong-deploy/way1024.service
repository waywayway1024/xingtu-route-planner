[Unit]
Description=way1024 route planning website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/way1024
EnvironmentFile=/etc/way1024.env
ExecStart=/usr/local/bin/node /opt/way1024/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
